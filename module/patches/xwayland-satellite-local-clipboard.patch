Cellward-only, opt-in CLIPBOARD fallback for a windowless X11 client.
Serial zero is consumed by Cellward's launch-local relay, never authorized
as a host compositor write. Existing keyboard serials and PRIMARY are unchanged.
Upstream source context: MPL-2.0, xwayland-satellite v0.8.3.

diff --git a/src/server/selection.rs b/src/server/selection.rs
index bd32aaa..6fad0d5 100644
--- a/src/server/selection.rs
+++ b/src/server/selection.rs
@@ -125,6 +125,7 @@ impl<S: X11Selection> InnerServerState<S> {
                 .as_ref()
                 .map(|(_seat, serial)| serial)
                 .copied()
+                .or_else(T::local_selection_serial)
             {
                 T::set_selection(inner, state.device.as_ref().unwrap(), serial);
             }
@@ -187,6 +188,10 @@ pub trait SelectionType: Sized {
 
     fn set_selection(source: &Self::Source, device: &Self::DataDevice, serial: u32);
 
+    fn local_selection_serial() -> Option<u32> {
+        None
+    }
+
     fn get_events(world: &mut MyWorld) -> &mut SelectionEvents<Self::Offer>;
 
     fn receive_offer(offer: &Self::Offer, mime_type: String) -> std::io::Result<ReadPipe>;
@@ -203,6 +208,12 @@ pub enum Primary {}
 
 #[allow(private_bounds, private_interfaces)]
 impl SelectionType for Clipboard {
