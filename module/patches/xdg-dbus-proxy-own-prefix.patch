 void
+flatpak_proxy_add_own_prefix (FlatpakProxy *proxy,
+                              const char   *prefix)
+{
+  g_ptr_array_add (proxy->own_prefixes, g_strdup (prefix));
+}
+
+/* The name is PREFIX followed by at least one of [A-Za-z0-9_-] and nothing
+ * else: no dot, so no namespace below it — unless PREFIX ends with a dot
+ * (`--own=NAME.*`): then elements of those, separated by single dots. */
+static gboolean
+own_prefix_matches (FlatpakProxy *proxy, const char *name)
+{
+  guint i;
+
+  for (i = 0; i < proxy->own_prefixes->len; i++)
+    {
+      const char *prefix = g_ptr_array_index (proxy->own_prefixes, i);
+      const char *rest;
+
+      if (!g_str_has_prefix (name, prefix))
+        continue;
+
+      gboolean dotted = g_str_has_suffix (prefix, ".");
+      rest = name + strlen (prefix);
+      if (*rest == 0 || *rest == '.')
+        continue;
+
+      for (; *rest != 0; rest++)
+        if (!g_ascii_isalnum (*rest) && *rest != '_' && *rest != '-'
+            && !(dotted && *rest == '.' && rest[1] != '.' && rest[1] != 0))
+          break;
+
+      if (*rest == 0)
+        return TRUE;
+    }
+
+  return FALSE;
+}
